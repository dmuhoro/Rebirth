GEMINI_API_KEY=

# Server-side AI budget guardrails (USD). Invalid, negative, or zero values
# fail closed and refuse AI calls. Estimated cost is deliberately rounded up.
GEMINI_DAILY_SPEND_CAP_USD=5.00
GEMINI_ESTIMATED_REQUEST_COST_USD=0.01

# `npx convex dev` writes development Convex URLs to .env.local.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public VAPID key used by browsers. Keep the matching private key in Convex
# environment variables only; never expose it through VITE_*.
VITE_WEB_PUSH_PUBLIC_KEY=
